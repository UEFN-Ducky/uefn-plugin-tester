{
  "id": "tester",
  "kind": "plugin",
  "version": "1.0.25",
  "label": "UEFN Testing",
  "description": "Device-graph simulation, Verse harness tests, session probes \u2014 MCP tools plus the Tester dock. Bundles the tester skill. Serial editor ops (one MCP call per turn).",
  "min_app_version": "1.0.0",
  "default_enabled": true,
  "secret_keys": [],
  "contributes": {
    "agent.tools": {
      "category": "tester",
      "tools": [
        "device_graph_snapshot",
        "simulate_device_event",
        "device_graph_audit",
        "verse_test_scaffold",
        "verse_test_run",
        "verse_test_results",
        "session_status",
        "actor_state_snapshot",
        "actor_state_diff",
        "tester_list_devices",
        "tester_list_tests",
        "tester_create_simulation",
        "tester_run_simulation",
        "verse_test_add_case",
        "tester_get_results"
      ],
      "intent_pattern": "\\b(test|tester|simulate|device\\s*graph|harness|session\\s*probe)\\b",
      "plan_tools": [
        "device_graph_snapshot",
        "device_graph_audit",
        "verse_test_results",
        "session_status",
        "actor_state_snapshot",
        "actor_state_diff",
        "tester_list_devices",
        "tester_list_tests",
        "tester_get_results"
      ]
    },
    "dock.panels": [
      {
        "id": "tester",
        "title": "UEFN Testing",
        "defaultSide": "right",
        "ui": "builtin:tester-dock"
      }
    ],
    "automations": {
      "nodes": [
        {
          "id": "uefn.game.start",
          "label": "Start game",
          "group": "UEFN Playtest",
          "systems": [
            "pipeline"
          ],
          "description": "Start the island session (Epic first).",
          "config_fields": []
        },
        {
          "id": "uefn.player.wait",
          "label": "Wait for player",
          "group": "UEFN Playtest",
          "systems": [
            "pipeline"
          ],
          "description": "Block until a player pawn is in the session.",
          "config_fields": [
            {
              "id": "timeout_sec",
              "label": "Timeout (seconds)",
              "type": "number"
            }
          ]
        },
        {
          "id": "uefn.player.teleport",
          "label": "Teleport player",
          "group": "UEFN Playtest",
          "systems": [
            "pipeline"
          ],
          "description": "Move the live player to a teleporter / actor label or x,y,z.",
          "config_fields": [
            {
              "id": "teleporter",
              "label": "Teleporter / actor label",
              "type": "string"
            },
            {
              "id": "x",
              "label": "X",
              "type": "number"
            },
            {
              "id": "y",
              "label": "Y",
              "type": "number"
            },
            {
              "id": "z",
              "label": "Z",
              "type": "number"
            }
          ]
        },
        {
          "id": "uefn.log.expect",
          "label": "Expect log",
          "group": "UEFN Playtest",
          "systems": [
            "pipeline"
          ],
          "description": "Poll the editor log until a regex matches.",
          "config_fields": [
            {
              "id": "regex",
              "label": "Regex",
              "type": "string"
            },
            {
              "id": "timeout_sec",
              "label": "Timeout (seconds)",
              "type": "number"
            }
          ]
        }
      ]
    },
    "walkthrough": {
      "id": "tester",
      "title": "Tester tools ready",
      "auto_start": "first_enable",
      "settings_tab": "Store",
      "steps": [
        {
          "target": "settings.store.root",
          "title": "Tester tools ready",
          "body": "Testing MCP tools are live. Ask to simulate device graphs, run Verse harness asserts, or probe the session.",
          "advance": "next",
          "mode": "rect"
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
